{
  // Markdown style config for check-docs.sh (advisory). Tuned for this repo:
  // long lines, inline HTML in the README, and emoji headings are all fine here.
  "default": true,
  "MD013": false, // line length — docs and .ai briefs use long lines on purpose
  "MD033": false, // inline HTML — the README uses <p>/<img> for the banner
  "MD041": false, // first line need not be an H1 (badges/front-matter come first)
  "MD024": false, // duplicate headings — repeated section names across skills are fine
  "MD026": false, // trailing punctuation in headings
  "MD007": { "indent": 4 } // the README/task lists use 4-space nesting
}
